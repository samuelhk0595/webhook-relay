# Docker Compose: copy to .env at the repository root; do not commit real secrets.
DOMAIN=hooks.example.com
CADDY_EMAIL=operator@example.com
BOOTSTRAP_USERNAME=admin
MAX_BODY_BYTES=10485760
MAX_HEADER_BYTES=65536
INGRESS_CONCURRENCY=64
WORKER_CONCURRENCY=16
DESTINATION_CONCURRENCY=2
RETENTION_DAYS=7
FAILED_RETENTION_DAYS=30

# Local Rust development (export variables explicitly; Rust does not load .env):
# PUBLIC_URL=http://localhost:8080
# LISTEN_ADDR=127.0.0.1:8080
# DATABASE_PATH=data/forwarder.db
# ADMIN_DIST=../frontend/dist
# COOKIE_SECURE=false
# DEV_ORIGIN=http://127.0.0.1:5173
# BOOTSTRAP_PASSWORD_FILE=/absolute/path/to/local-password.txt
